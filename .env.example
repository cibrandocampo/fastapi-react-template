# Copy this file to .env and fill in the values (`make init` does it for development).
# .env is git-ignored: never commit secrets.
# Both docker-compose.yml (production) and dev/docker-compose.yml read this file.
# Every variable is described in docs/configuration.md.

# --- Project ---
PROJECT_NAME=myapp
APP_NAME=My App

# --- Database (PostgreSQL) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Sessions ---
# Long random string; production refuses the default. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# A just-rotated refresh token sent again within this many seconds (two tabs) is refused
# without ending the session.
REFRESH_REUSE_GRACE_SECONDS=10
# bcrypt cost factor for password hashes.
BCRYPT_ROUNDS=12
# Keep true behind HTTPS. Set false only when the app is served over plain HTTP.
COOKIE_SECURE=true

# --- First administrator (created at start-up if no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
